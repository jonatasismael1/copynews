{
  "name": "dbe-copynews",
  "account_id": "c8e0e96360a788843e78c1de5a1cc73b",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": {
    "command": "npm run check"
  },
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "copynews.dbe.digital",
      "zone_id": "23a356e3aec655269479b763b2382c4c",
      "custom_domain": true
    }
  ],
  "main": "./worker.mjs"
}
